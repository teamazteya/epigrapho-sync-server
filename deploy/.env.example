# Copy to .env (chmod 600). The agent generates the random values on the VM;
# the person fills SMTP_USERNAME and SMTP_PASSWORD from Brevo.
EPIGRAPHO_TAG=v1.0-beta.38-ep.1
INSTANCE_NAME=Epigrapho
DISABLE_SIGNUPS=false
EPIGRAPHO_STORAGE_LIMIT_MB=500
NOTESNOOK_CORS_ORIGINS=https://app.epigrapho.local,http://localhost:3000

# openssl rand -hex 32
NOTESNOOK_API_SECRET=
# Garage: init-garage.sh creates the key with these values.
# S3_KEY_ID is "GK" + openssl rand -hex 12; S3_SECRET is openssl rand -hex 32.
S3_KEY_ID=
S3_SECRET=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTESNOOK_SENDER_EMAIL=no-reply@azteya.tech
SMTP_REPLYTO_EMAIL=support@azteya.tech
